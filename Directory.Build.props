<Project>
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>0.5.6</Version>
    <Authors>Aleqsd</Authors>
    <RepositoryUrl>https://github.com/Aleqsd/codex-tracker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Product>Codex Tracker</Product>
    <Description>Suivi local des quotas Codex depuis la barre des tâches Windows.</Description>
  </PropertyGroup>
</Project>
