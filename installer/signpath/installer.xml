<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
    <parameter name="productName" required="true" />
    <parameter name="productVersion" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="CodexTracker-${version}-Setup.exe" product-name="${productName}" product-version="${productVersion}">
      <authenticode-sign hash-algorithm="sha256" description="Codex Tracker Setup" description-url="https://github.com/Aleqsd/codex-tracker" />
    </pe-file>
  </zip-file>
</artifact-configuration>
