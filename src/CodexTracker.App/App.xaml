<Application x:Class="CodexTracker.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="clr-namespace:CodexTracker.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <FontFamily x:Key="AppFontFamily">/CodexTracker;component/Assets/Fonts/#Roboto</FontFamily>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/></Style>
  <!-- Applied explicitly by derived windows: implicit Window styles do not match subclasses. -->
  <Style TargetType="Window">
   <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
   <Setter Property="UseLayoutRounding" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/>
   <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
   <!-- Natural glyph positioning and system smoothing keep text fluid at fractional DPI. -->
   <Setter Property="TextOptions.TextRenderingMode" Value="Auto"/>
   <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
   <!-- Theme backgrounds are opaque; transparency introduced by children is still handled by WPF. -->
   <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
  </Style>
  <!-- Keyboard focus only: a mouse click does not draw the ring. -->
  <Style x:Key="FocusRing"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border Margin="-2" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource FocusBrush}" SnapsToDevicePixels="True"/></ControlTemplate></Setter.Value></Setter></Style>
