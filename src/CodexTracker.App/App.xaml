     </ToggleButton>
     <ContentPresenter x:Name="Details" ContentSource="Content" Visibility="Collapsed" motion:UiMotion.Rise="6" motion:UiMotion.FadeOnShow="True"/>
    </StackPanel></Border>
    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
