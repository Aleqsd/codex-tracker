<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CodexTracker</AssemblyName>
    <RootNamespace>CodexTracker.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CodexTracker.UiSmoke" />
    <Resource Include="Assets\App.ico" />
    <ProjectReference Include="..\CodexTracker.Core\CodexTracker.Core.csproj" />
    <ProjectReference Include="..\CodexTracker.Codex\CodexTracker.Codex.csproj" />
  </ItemGroup>
</Project>
