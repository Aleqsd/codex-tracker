<Window x:Class="CodexTracker.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Title="Codex Tracker" Icon="Assets/App.ico" Width="760" Height="620" MinWidth="630" MinHeight="500" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Resources>
  <DataTemplate x:Key="ReserveTooltip"><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="390"/></DataTemplate>
  <Style x:Key="ReserveMetric" TargetType="Border"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0,4"/><Setter Property="MinHeight" Value="26"/><Setter Property="MinWidth" Value="34"/><Setter Property="ToolTipService.InitialShowDelay" Value="150"/><Setter Property="ToolTipService.ShowDuration" Value="60000"/></Style>
  <Style x:Key="ProviderIconImage" TargetType="Image"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Source" Value="{DynamicResource CodexProviderIcon}"/><Style.Triggers><DataTrigger Binding="{Binding IsClaude}" Value="True"><Setter Property="Source" Value="{DynamicResource ClaudeProviderIcon}"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="45" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource ChromeBrush}"><Grid Margin="19,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&gt;_" FontWeight="Medium" Margin="0,0,10,0"/><TextBlock Text="Codex Tracker" FontSize="13" FontWeight="Medium"/><TextBlock Text="  ·  démo" Style="{StaticResource Muted}" Visibility="{Binding IsDemo, Converter={StaticResource BoolVisibility}}"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button x:Name="HideToTrayButton" ToolTip="Masquer dans la barre d’état — le suivi reste actif" AutomationProperties.Name="Masquer dans la barre d’état" Click="Hide_Click" Style="{StaticResource QuietButton}" Width="36" Height="34" Padding="9" VerticalAlignment="Center">
     <Grid Width="18" Height="18" IsHitTestVisible="False"><Path Data="M 3,3 L 14,14 M 14,14 L 8,14 M 14,14 L 14,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Grid>
    </Button>
    <Button x:Name="MinimizeButton" ToolTip="Réduire dans la barre des tâches" AutomationProperties.Name="Réduire dans la barre des tâches" Click="Minimize_Click" Style="{StaticResource QuietButton}" Width="36" Height="34" Padding="9" VerticalAlignment="Center"><Grid Width="18" Height="18" IsHitTestVisible="False"><Path Data="M 3,9 L 15,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/></Grid></Button><Button Content="✕" ToolTip="Masquer dans la barre d’état" AutomationProperties.Name="Masquer dans la barre d’état" Click="Hide_Click" Style="{StaticResource QuietButton}" Padding="10,5"/></StackPanel>
  </Grid></Border>
  <StackPanel Grid.Row="1">
  <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,12">
   <DockPanel LastChildFill="True">
    <Button x:Name="UpdateNowButton" DockPanel.Dock="Right" Content="Mettre à jour et relancer" Click="UpdateNow_Click" Style="{StaticResource PrimaryButton}" Padding="14,8" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Installer la mise à jour téléchargée et relancer Codex Tracker"/>
    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="UpdateHeadline" FontSize="12" FontWeight="Medium"/><TextBlock x:Name="UpdateHint" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
   </DockPanel>
  </Border>
  <Border x:Name="RecoveryBanner" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,8">
   <DockPanel LastChildFill="True"><Button Content="Vérifier" DockPanel.Dock="Right" Click="Recovery_Click" Style="{StaticResource QuietButton}" Margin="12,0,0,0" AutomationProperties.Name="Vérifier les données et les rappels dans les réglages"/><TextBlock Text="Des données locales ou des rappels nécessitent votre attention." TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center"/></DockPanel>
  </Border>
  </StackPanel>
  <TabControl x:Name="MainTabs" Grid.Row="2" Margin="22,9,20,12" Style="{StaticResource MainTabsStyle}">
   <TabItem x:Name="AccountsTab" Header="Comptes" Tag="{StaticResource AccountsIcon}" Style="{StaticResource MainTabStyle}">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,15,0,0">
  <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="13,10" Margin="0,0,0,13" Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Changez de compte dans Codex ou Claude Code : le tracker suit automatiquement. Glissez son icône dans la barre d’état pour la garder visible." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,14,0"/><Button Grid.Column="1" Content="Compris" Click="Onboarding_Click" Padding="9,5" VerticalAlignment="Center"/></Grid></Border>
   <Border x:Name="ActiveAccountCard" Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="20,17" Visibility="{Binding HasActive, Converter={StaticResource BoolVisibility}}">
    <ItemsControl ItemsSource="{Binding ActiveAccounts}"><ItemsControl.ItemTemplate><DataTemplate>
    <Grid Margin="0,4,0,8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,22,0" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal"><Image Style="{StaticResource ProviderIconImage}" Width="22" Height="22"/><TextBlock Text="{Binding SummaryLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SummaryLabel}"/></StackPanel>
      <TextBlock Text="{Binding Email}" FontSize="16" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding Email}"/>
      <WrapPanel Margin="0,11,0,0">
       <Border Style="{StaticResource ReserveMetric}" Margin="0,0,18,0" Visibility="{Binding HasReserves, Converter={StaticResource BoolVisibility}}">
        <Border.ToolTip><ToolTip Content="{Binding ReserveHint}" ContentTemplate="{StaticResource ReserveTooltip}"/></Border.ToolTip>
        <TextBlock Text="{Binding ReserveSummary}" Foreground="{Binding ReserveBrush}" FontSize="11" FontWeight="Medium"/>
       </Border>
       <TextBlock Text="{Binding ShortSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
      </WrapPanel>
     </StackPanel>
     <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="22,0,0,0">
      <StackPanel VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding WeeklyNumber}" TextOptions.TextFormattingMode="Ideal" FontSize="30" FontWeight="Medium" Foreground="{Binding WeeklyBrush}"/>
        <TextBlock Text="{Binding WeeklyDisplayLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="8,0,0,7"/>
       </StackPanel>
       <ProgressBar Value="{Binding WeeklyPercent, Mode=OneWay}" Foreground="{Binding WeeklyBrush}" Margin="0,8,0,10"/>
       <TextBlock Text="{Binding SummaryReset}" ToolTip="{Binding ResetHint}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
    </Grid>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </Border>
   <StackPanel Grid.Row="2">
   <Border x:Name="ManualResetBanner" Margin="0,10,0,0" Padding="12,8" Background="{DynamicResource PanelBrush}" Visibility="{Binding HasManualReset, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding ManualResetHint}"><DockPanel><Button DockPanel.Dock="Right" Content="Modifier…" Click="ManualCodexReset_Click" Style="{StaticResource QuietButton}" Margin="8,0,0,0"/><TextBlock Text="{Binding ManualResetCaption}" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center"/></DockPanel></Border>
   <Border x:Name="ExpectedResetsBanner" Margin="0,12,0,0" Padding="12,8" BorderThickness="2,0,0,0" BorderBrush="{DynamicResource GoodBrush}" Background="{DynamicResource PanelBrush}" Visibility="{Binding HasExpectedResets, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding ExpectedResetsHint}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ExpectedResetsTitle}" FontSize="12" FontWeight="Medium" TextWrapping="Wrap"/><TextBlock Text="{Binding ExpectedResetsNames}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/><TextBlock Text="{Binding ExpectedResetsCaption}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><Button x:Name="ShowExpectedResetButton" Grid.Column="1" Content="Voir" Click="ExpectedReset_Click" Style="{StaticResource QuietButton}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Voir le compte probablement rechargé"/></Grid>
   </Border>
   <Grid Margin="1,9,0,0" Visibility="{Binding HasAdvice, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding AdviceHint}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding AdviceTitle}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding AdviceAge}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
    <Button Grid.Column="1" Content="Voir" Click="Advice_Click" Style="{StaticResource QuietButton}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Consulter ce relevé avant de changer de compte dans Codex"/>
   </Grid>
   </StackPanel>
   <Grid Grid.Row="3" Margin="0,17,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Comptes" FontSize="13" FontWeight="Medium"/><TextBlock Text="{Binding AccountCount}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="7,1,0,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="DeclareCodexResetButton" Content="Reset Codex…" Click="ManualCodexReset_Click" Style="{StaticResource QuietButton}" Padding="9,5" AutomationProperties.Name="Déclarer un reset de tous les comptes Codex"/><Button Content="↻" FontSize="16" Padding="10,4" Margin="8,0,0,0" Click="Refresh_Click" IsEnabled="{Binding IsIdle}" ToolTip="Actualiser et détecter les comptes Codex et Claude Code" AutomationProperties.Name="Actualiser les quotas"/></StackPanel></Grid>
   <StackPanel>
    <Border Padding="24,35" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Ouvrez Codex ou Claude Code pour commencer." FontSize="17" FontWeight="Medium" TextAlignment="Center"/><TextBlock Text="Le compte connecté apparaîtra ici automatiquement." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextAlignment="Center" Margin="0,10,0,16"/><Button Content="Détecter maintenant" Click="Import_Click" HorizontalAlignment="Center"/></StackPanel></Border>
    <ItemsControl x:Name="AccountsList" ItemsSource="{Binding Accounts}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel>
     <Grid Tag="ProviderSectionHeader" Margin="7,15,12,6" Visibility="{Binding ShowProviderHeader, Converter={StaticResource BoolVisibility}}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/><ColumnDefinition Width="65"/><ColumnDefinition Width="92"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.ColumnSpan="6" LastChildFill="True" Margin="0,0,0,13"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,14,0"><Image Style="{StaticResource ProviderIconImage}"/><TextBlock Text="{Binding ProviderName}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/><TextBlock Text="{Binding ProviderCount}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" VerticalAlignment="Center"/></DockPanel>
      <TextBlock Grid.Row="1" Grid.Column="2" Text="Semaine" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="Resets" ToolTip="Resets disponibles en réserve : survolez le nombre pour voir les dates" Foreground="{DynamicResource MutedBrush}" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsClaude}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBlock Grid.Row="1" Grid.Column="4" Text="Prochain reset" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
     </Grid>
     <Border Background="{Binding RowBackground}" BorderBrush="{Binding CardBorder}" BorderThickness="0,0,0,1" Padding="7,8" Margin="0,0,5,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/><ColumnDefinition Width="65"/><ColumnDefinition Width="92"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
      <Button Tag="{Binding Id}" Click="Avatar_Click" Style="{StaticResource AvatarButton}" Width="33" Height="33" ToolTip="Changer le nom ou l’avatar" AutomationProperties.Name="Personnaliser l’avatar du compte" HorizontalAlignment="Left" VerticalAlignment="Center"><Border Width="29" Height="29" Background="{Binding AvatarBackground}" CornerRadius="15" VerticalAlignment="Center" HorizontalAlignment="Left"><Grid><TextBlock Text="{Binding Initials}" Foreground="White" FontSize="10" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasAvatar}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Border CornerRadius="15" Visibility="{Binding HasAvatar, Converter={StaticResource BoolVisibility}}"><Border.Background><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/></Border.Background></Border></Grid></Border></Button>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding Email}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding IdentityHint}"/><TextBlock Text="{Binding RowSubtitle}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Freshness}"/><TextBlock Text="{Binding EstimateLabel}" Foreground="{DynamicResource GoodBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" ToolTip="{Binding EstimateHint}" Visibility="{Binding HasResetNotice, Converter={StaticResource BoolVisibility}}"/></StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" ToolTip="{Binding WeeklyHint}"><TextBlock Text="{Binding WeeklyDisplayNumber}" Foreground="{Binding WeeklyDisplayBrush}" FontSize="16" FontWeight="Medium"/><TextBlock Text="estimé" Foreground="{DynamicResource MutedBrush}" FontSize="10" Visibility="{Binding HasWeeklyEstimate, Converter={StaticResource BoolVisibility}}"/></StackPanel>
            <Border Grid.Column="3" Style="{StaticResource ReserveMetric}" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="{Binding ReserveSummary}"><Border.ToolTip><ToolTip Content="{Binding ReserveHint}" ContentTemplate="{StaticResource ReserveTooltip}"/></Border.ToolTip><TextBlock Text="{Binding ReserveCount}" Foreground="{Binding ReserveBrush}" FontSize="16" FontWeight="Medium"/></Border>
      <StackPanel Grid.Column="4" VerticalAlignment="Center" ToolTip="{Binding ResetHint}"><TextBlock Text="{Binding ResetCompact}" FontSize="11"/></StackPanel>
      <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="···" Tag="{Binding Id}" Click="Details_Click" ToolTip="Détails et historique" AutomationProperties.Name="Détails et historique du compte" Style="{StaticResource QuietButton}" Padding="7,6" FontSize="14"/></StackPanel>
     </Grid></Border>
    </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
  </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem x:Name="ResetsTab" Header="Resets" Tag="{StaticResource DropdownRefreshIcon}" Style="{StaticResource MainTabStyle}"/>
   <TabItem x:Name="SettingsTab" Header="Réglages" Tag="{StaticResource SettingsGeneralIcon}" Style="{StaticResource MainTabStyle}" AutomationProperties.Name="Réglages"/>
  </TabControl>
  <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding StatusText}" ToolTip="{Binding StatusHint}" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="AppVersionLabel" Grid.Column="2" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Version installée de Codex Tracker"/></Grid></Border>
 </Grid></Border>
</Window>
