<Window x:Class="CodexTracker.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:CodexTracker.App" Style="{StaticResource {x:Type Window}}" Title="Codex Tracker" Icon="Assets/App.ico" Width="760" Height="620" MinWidth="630" MinHeight="500" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Resources>
  <DataTemplate x:Key="ReserveTooltip"><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="390"/></DataTemplate>
  <Style x:Key="ReserveMetric" TargetType="Border"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0,4"/><Setter Property="MinHeight" Value="26"/><Setter Property="MinWidth" Value="34"/><Setter Property="ToolTipService.InitialShowDelay" Value="150"/><Setter Property="ToolTipService.ShowDuration" Value="60000"/></Style>
  <Style x:Key="ProviderIconImage" TargetType="Image"><Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Source" Value="{DynamicResource CodexProviderIcon}"/><Style.Triggers><DataTrigger Binding="{Binding IsClaude}" Value="True"><Setter Property="Source" Value="{DynamicResource ClaudeProviderIcon}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="Callout" TargetType="Border"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="0,12,0,0"/></Style>
  <Style x:Key="AccountRow" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1,0,1,1"/><Setter Property="Padding" Value="12,9"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding ShowProviderHeader}" Value="True"><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12,12,0,0"/></DataTrigger>
    <DataTrigger Binding="{Binding IsLastInSection}" Value="True"><Setter Property="CornerRadius" Value="0,0,12,12"/></DataTrigger>
    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ShowProviderHeader}" Value="True"/><Condition Binding="{Binding IsLastInSection}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="CornerRadius" Value="12"/></MultiDataTrigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="8,0,0,0"/></Style>
 </Window.Resources>
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><Grid local:UiMotion.Rise="8" local:UiMotion.FadeOnShow="True">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <TabControl x:Name="MainTabs" Style="{StaticResource MainTabsStyle}" Padding="24,0,18,0">
   <TabItem x:Name="AccountsTab" Header="Comptes" Tag="{StaticResource AccountsIcon}" Style="{StaticResource MainTabStyle}">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,6,6,22">
    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12" Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Changez de compte dans Codex ou Claude Code : le tracker suit automatiquement. Glissez son icône dans la barre d’état pour la garder visible." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Compris" Click="Onboarding_Click" Padding="11,6" VerticalAlignment="Center"/></Grid></Border>
    <Border x:Name="ActiveAccountCard" Visibility="{Binding HasActive, Converter={StaticResource BoolVisibility}}">
     <ItemsControl ItemsSource="{Binding ActiveAccounts}" Margin="0,0,-12,0">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" local:UiMotion.Rise="14" local:UiMotion.Stagger="True"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Style="{StaticResource Card}" Padding="18,15,18,16" Margin="0,0,12,0">
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <DockPanel>
          <Image Style="{StaticResource ProviderIconImage}" Width="18" Height="18" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding SummaryLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SummaryLabel}"/>
         </DockPanel>
         <Grid Grid.Row="1" Margin="0,14,0,0">
          <!-- A lone active account keeps a readable detail column instead of spreading across the window. -->
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100*" MaxWidth="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid Width="86" Height="86" VerticalAlignment="Top" ToolTip="{Binding WeeklyHint}">
           <local:QuotaRing Value="{Binding WeeklyPercent, Mode=OneWay}" RingBrush="{Binding WeeklyBarBrush}" TrackBrush="{DynamicResource TrackBrush}" Thickness="7"/>
           <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding WeeklyNumber}" FontSize="22" FontWeight="Medium" Foreground="{Binding WeeklyBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding WeeklyRingCaption}" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
           </StackPanel>
          </Grid>
          <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
           <TextBlock Text="{Binding Email}" FontSize="15" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Email}"/>
           <TextBlock Text="{Binding PlanBadge}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
           <Grid Margin="0,12,0,0" ToolTip="{Binding ShortSummary}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="5 heures" Style="{StaticResource MetricLabel}"/>
            <ProgressBar Grid.Column="1" Height="4" Margin="10,0,0,0" MinWidth="24" Value="{Binding ShortPercent, Mode=OneWay}" Foreground="{Binding ShortBarBrush}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding ShortWindowRemaining}" Style="{StaticResource MetricValue}"/>
           </Grid>
           <Grid Margin="0,8,0,0" ToolTip="{Binding ResetHint}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Reset semaine" Style="{StaticResource MetricLabel}"/>
            <TextBlock Grid.Column="1" Text="{Binding ResetCompact}" Style="{StaticResource MetricValue}"/>
           </Grid>
           <Grid Margin="0,8,0,0" ToolTip="{Binding ForecastHint}" Visibility="{Binding HasForecast, Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ForecastLabel}" Style="{StaticResource MetricLabel}"/>
            <TextBlock Grid.Column="1" Text="{Binding ForecastText}" Foreground="{Binding ForecastBrush}" Style="{StaticResource MetricValue}"/>
           </Grid>
           <Border Style="{StaticResource ReserveMetric}" Padding="0" MinHeight="0" Margin="0,8,0,0" Visibility="{Binding HasReserves, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding ReserveSummary}">
            <Border.ToolTip><ToolTip Content="{Binding ReserveHint}" ContentTemplate="{StaticResource ReserveTooltip}"/></Border.ToolTip>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Resets en réserve" Style="{StaticResource MetricLabel}"/><TextBlock Grid.Column="1" Text="{Binding ReserveCount}" Foreground="{Binding ReserveBrush}" Style="{StaticResource MetricValue}"/></Grid>
           </Border>
          </StackPanel>
         </Grid>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </Border>
    <Border x:Name="ManualResetBanner" local:UiMotion.Rise="8" local:UiMotion.FadeOnShow="True" Style="{StaticResource Callout}" Background="{DynamicResource AccentSoftBrush}" Visibility="{Binding HasManualReset, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding ManualResetHint}">
     <DockPanel><Button DockPanel.Dock="Right" Content="Modifier…" Click="ManualCodexReset_Click" Style="{StaticResource QuietButton}" Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/><Viewbox DockPanel.Dock="Left" Width="17" Height="17" Margin="0,0,11,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource DropdownRefreshIcon}" Style="{StaticResource IconPath}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/></Canvas></Viewbox><TextBlock Text="{Binding ManualResetCaption}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/></DockPanel>
    </Border>
    <Border x:Name="ExpectedResetsBanner" local:UiMotion.Rise="8" local:UiMotion.FadeOnShow="True" Style="{StaticResource Callout}" Background="{DynamicResource GoodSoftBrush}" Visibility="{Binding HasExpectedResets, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding ExpectedResetsHint}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Viewbox Width="17" Height="17" Margin="0,1,11,0" VerticalAlignment="Top"><Canvas Width="24" Height="24"><Path Data="{StaticResource DropdownRefreshIcon}" Style="{StaticResource IconPath}" Stroke="{DynamicResource GoodBrush}" StrokeThickness="2"/></Canvas></Viewbox>
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding ExpectedResetsTitle}" FontSize="12" FontWeight="Medium" TextWrapping="Wrap"/><TextBlock Text="{Binding ExpectedResetsNames}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/><TextBlock Text="{Binding ExpectedResetsCaption}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
      <Button x:Name="ShowExpectedResetButton" Grid.Column="2" Content="Voir" Click="ExpectedReset_Click" Style="{StaticResource QuietButton}" Foreground="{DynamicResource GoodBrush}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Voir le compte probablement rechargé"/>
     </Grid>
    </Border>
    <Border local:UiMotion.Rise="8" local:UiMotion.FadeOnShow="True" Style="{StaticResource Callout}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Visibility="{Binding HasAdvice, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding AdviceHint}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Viewbox Width="17" Height="17" Margin="0,0,11,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource DropdownClockIcon}" Style="{StaticResource IconPath}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2"/></Canvas></Viewbox>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding AdviceTitle}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding AdviceAge}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
      <Button Grid.Column="2" Content="Voir" Click="Advice_Click" Style="{StaticResource QuietButton}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Consulter ce relevé avant de changer de compte dans Codex"/>
     </Grid>
    </Border>
    <Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Comptes" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"/><Border Style="{StaticResource Chip}" Margin="9,1,0,0"><TextBlock Text="{Binding AccountCount}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}"/></Border></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="DeclareCodexResetButton" Content="Reset Codex…" Click="ManualCodexReset_Click" Style="{StaticResource QuietButton}" Padding="11,7" AutomationProperties.Name="Déclarer un reset de tous les comptes Codex"/>
      <Button Width="34" Height="34" Padding="0" Margin="6,0,0,0" Click="Refresh_Click" IsEnabled="{Binding IsIdle}" ToolTip="Actualiser et détecter les comptes Codex et Claude Code" AutomationProperties.Name="Actualiser les quotas">
       <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="{StaticResource DropdownRefreshIcon}" Style="{StaticResource IconPath}" StrokeThickness="2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox>
      </Button>
     </StackPanel>
    </Grid>
    <StackPanel>
     <Border local:UiMotion.Rise="12" local:UiMotion.FadeOnShow="True" Style="{StaticResource Card}" Padding="24,32" Margin="0,14,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"><StackPanel>
      <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="{StaticResource AccountsIcon}" Style="{StaticResource IconPath}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/></Canvas></Viewbox></Border>
      <TextBlock Text="Ouvrez Codex ou Claude Code pour commencer." FontSize="16" FontWeight="Medium" TextAlignment="Center" Margin="0,14,0,0"/>
      <TextBlock Text="Le compte connecté apparaîtra ici automatiquement." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextAlignment="Center" Margin="0,8,0,18"/>
      <Button Content="Détecter maintenant" Click="Import_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"/>
     </StackPanel></Border>
     <ItemsControl x:Name="AccountsList" ItemsSource="{Binding Accounts}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel local:UiMotion.Rise="10" local:UiMotion.StaggerDelay="110" local:UiMotion.Stagger="True"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel>
      <Grid Tag="ProviderSectionHeader" Margin="13,18,13,8" Visibility="{Binding ShowProviderHeader, Converter={StaticResource BoolVisibility}}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/><ColumnDefinition Width="60"/><ColumnDefinition Width="92"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
       <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center"><Image Style="{StaticResource ProviderIconImage}" Width="20" Height="20"/><TextBlock Text="{Binding ProviderName}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/><TextBlock Text="{Binding ProviderCount}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="8,1,0,0" VerticalAlignment="Center"/></StackPanel>
       <TextBlock Grid.Column="2" Text="Semaine" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Bottom"/>
       <TextBlock Grid.Column="3" Text="Resets" ToolTip="Resets disponibles en réserve : survolez le nombre pour voir les dates" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Bottom"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsClaude}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <TextBlock Grid.Column="4" Text="Prochain reset" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Bottom"/>
      </Grid>
      <Border Style="{StaticResource AccountRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/><ColumnDefinition Width="60"/><ColumnDefinition Width="92"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
       <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Margin="-12,3,0,3" Visibility="{Binding IsActive, Converter={StaticResource BoolVisibility}}" ToolTip="Compte actif"/>
       <Button Tag="{Binding Id}" Click="Avatar_Click" Style="{StaticResource AvatarButton}" Width="36" Height="36" ToolTip="Changer le nom ou l’avatar" AutomationProperties.Name="Personnaliser l’avatar du compte" HorizontalAlignment="Left" VerticalAlignment="Center"><Border Width="30" Height="30" Background="{Binding AvatarBackground}" CornerRadius="15" VerticalAlignment="Center" HorizontalAlignment="Left"><Grid><TextBlock Text="{Binding Initials}" Foreground="White" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasAvatar}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Border CornerRadius="15" Visibility="{Binding HasAvatar, Converter={StaticResource BoolVisibility}}"><Border.Background><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/></Border.Background></Border></Grid></Border></Button>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding Email}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding IdentityHint}"/><TextBlock Text="{Binding RowSubtitle}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Freshness}"/><TextBlock Text="{Binding EstimateLabel}" Foreground="{DynamicResource GoodBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" ToolTip="{Binding EstimateHint}" Visibility="{Binding HasResetNotice, Converter={StaticResource BoolVisibility}}"/></StackPanel>
       <StackPanel Grid.Column="2" VerticalAlignment="Center" ToolTip="{Binding WeeklyHint}" Margin="0,0,10,0"><TextBlock Text="{Binding WeeklyDisplayNumber}" Foreground="{Binding WeeklyDisplayBrush}" FontSize="15" FontWeight="Medium"/><ProgressBar Height="4" Margin="0,5,0,0" Value="{Binding WeeklyDisplayPercent, Mode=OneWay}" Foreground="{Binding WeeklyDisplayBarBrush}"/><TextBlock Text="estimé" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" Visibility="{Binding HasWeeklyEstimate, Converter={StaticResource BoolVisibility}}"/></StackPanel>
       <Border Grid.Column="3" Style="{StaticResource ReserveMetric}" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="{Binding ReserveSummary}"><Border.ToolTip><ToolTip Content="{Binding ReserveHint}" ContentTemplate="{StaticResource ReserveTooltip}"/></Border.ToolTip><TextBlock Text="{Binding ReserveCount}" Foreground="{Binding ReserveBrush}" FontSize="15" FontWeight="Medium"/></Border>
       <TextBlock Grid.Column="4" Text="{Binding ResetCompact}" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding ResetHint}" TextTrimming="CharacterEllipsis"/>
       <Button Grid.Column="5" Style="{StaticResource IconButton}" Width="32" Height="32" HorizontalAlignment="Right" Tag="{Binding Id}" Click="Details_Click" ToolTip="Détails et historique" AutomationProperties.Name="Détails et historique du compte"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource MoreIcon}" Style="{StaticResource IconPath}" StrokeThickness="3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox></Button>
      </Grid></Border>
     </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem x:Name="ResetsTab" Header="Resets" Tag="{StaticResource DropdownRefreshIcon}" Style="{StaticResource MainTabStyle}"/>
   <TabItem x:Name="SettingsTab" Header="Réglages" Tag="{StaticResource SettingsGeneralIcon}" Style="{StaticResource MainTabStyle}" AutomationProperties.Name="Réglages"/>
  </TabControl>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Height="54" Margin="20,0,0,0" IsHitTestVisible="False">
   <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource PrimaryButtonBrush}" VerticalAlignment="Center"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource GaugeIcon}" Style="{StaticResource IconPath}" Stroke="{DynamicResource PrimaryButtonTextBrush}" StrokeThickness="2.6"/></Canvas></Viewbox></Border>
   <TextBlock Text="Codex Tracker" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0,0,0"/>
  </StackPanel>
  <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Height="54" Margin="0,0,9,0" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
   <Button x:Name="HideToTrayButton" ToolTip="Masquer dans la barre d’état — le suivi reste actif" AutomationProperties.Name="Masquer dans la barre d’état" Click="Hide_Click" Style="{StaticResource ChromeButton}" VerticalAlignment="Center">
    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource TrayIcon}" Style="{StaticResource IconPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox>
   </Button>
   <Button x:Name="MinimizeButton" ToolTip="Réduire dans la barre des tâches" AutomationProperties.Name="Réduire dans la barre des tâches" Click="Minimize_Click" Style="{StaticResource ChromeButton}" VerticalAlignment="Center">
    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource MinimizeIcon}" Style="{StaticResource IconPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox>
   </Button>
   <Button ToolTip="Masquer dans la barre d’état" AutomationProperties.Name="Masquer dans la barre d’état" Click="Hide_Click" Style="{StaticResource ChromeCloseButton}" VerticalAlignment="Center">
    <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="{StaticResource CloseIcon}" Style="{StaticResource IconPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox>
   </Button>
  </StackPanel>
  <StackPanel Grid.Row="1">
   <Border x:Name="UpdateBanner" local:UiMotion.Rise="10" local:UiMotion.FadeOnShow="True" Visibility="Collapsed" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,10,14,10">
    <DockPanel LastChildFill="True">
     <Button x:Name="UpdateNowButton" DockPanel.Dock="Right" Content="Mettre à jour et relancer" Click="UpdateNow_Click" Style="{StaticResource PrimaryButton}" Padding="14,8" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Installer la mise à jour téléchargée et relancer Codex Tracker"/>
     <Viewbox DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource DownloadIcon}" Style="{StaticResource IconPath}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/></Canvas></Viewbox>
     <StackPanel VerticalAlignment="Center"><TextBlock x:Name="UpdateHeadline" FontSize="12" FontWeight="Medium"/><TextBlock x:Name="UpdateHint" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
    </DockPanel>
   </Border>
   <Border x:Name="RecoveryBanner" local:UiMotion.Rise="10" local:UiMotion.FadeOnShow="True" Visibility="Collapsed" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,8,14,8">
    <DockPanel LastChildFill="True"><Button Content="Vérifier" DockPanel.Dock="Right" Click="Recovery_Click" Style="{StaticResource QuietButton}" Foreground="{DynamicResource WarningBrush}" Margin="12,0,0,0" AutomationProperties.Name="Vérifier les données et les rappels dans les réglages"/><Viewbox DockPanel.Dock="Left" Width="17" Height="17" Margin="0,0,11,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource AlertIcon}" Style="{StaticResource IconPath}" Stroke="{DynamicResource WarningBrush}" StrokeThickness="2"/></Canvas></Viewbox><TextBlock Text="Des données locales ou des rappels nécessitent votre attention." TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/></DockPanel>
   </Border>
  </StackPanel>
  <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource ChromeBrush}" Padding="20,0,16,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Center"><Ellipse Fill="{Binding StatusBrush}" Opacity="0" local:UiMotion.Pulse="{Binding IsBusy}"/><Ellipse Fill="{Binding StatusBrush}"/></Grid>
   <TextBlock Grid.Column="1" Text="{Binding StatusText}" ToolTip="{Binding StatusHint}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   <Border Grid.Column="2" Style="{StaticResource Chip}" Background="{DynamicResource AccentSoftBrush}" Margin="12,0,0,0" Visibility="{Binding IsDemo, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Démo · comptes fictifs" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}"/></Border>
   <TextBlock x:Name="AppVersionLabel" Grid.Column="3" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Version installée de Codex Tracker"/>
  </Grid></Border>
 </Grid></Border>
</Window>
