{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "${empty}",
      "wrap": true,
      "isSubtle": true,
      "$when": "${empty != ''}"
    },
    {
      "type": "Container",
      "$when": "${$host.widgetSize == 'small' && count(accounts) > 0}",
      "items": [
        { "type": "TextBlock", "text": "${first.provider}", "size": "Small", "isSubtle": true, "weight": "Bolder" },
        { "type": "TextBlock", "text": "${first.percent}", "size": "ExtraLarge", "weight": "Bolder", "color": "${first.color}", "spacing": "None" },
        {
          "type": "ColumnSet",
          "spacing": "Small",
          "columns": [
            { "type": "Column", "width": "${first.fill}", "style": "${first.bar}", "minHeight": "6px", "items": [] },
            { "type": "Column", "width": "${first.rest}", "style": "emphasis", "minHeight": "6px", "spacing": "None", "items": [] }
          ]
        },
        { "type": "TextBlock", "text": "${first.reset}", "size": "Small", "isSubtle": true, "wrap": true, "spacing": "Small" }
      ]
    },
    {
      "type": "Container",
      "$when": "${$host.widgetSize != 'small'}",
      "items": [
        {
          "type": "Container",
          "$data": "${accounts}",
          "spacing": "Medium",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "verticalContentAlignment": "Center",
                  "items": [
                    { "type": "TextBlock", "text": "${provider}", "size": "Small", "isSubtle": true, "weight": "Bolder" },
                    { "type": "TextBlock", "text": "${name}", "spacing": "None", "maxLines": 1 }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "verticalContentAlignment": "Center",
                  "items": [
                    { "type": "TextBlock", "text": "${percent}", "size": "ExtraLarge", "weight": "Bolder", "color": "${color}", "horizontalAlignment": "Right" }
                  ]
                }
              ]
            },
            {
              "type": "ColumnSet",
              "spacing": "Small",
              "columns": [
                { "type": "Column", "width": "${fill}", "style": "${bar}", "minHeight": "6px", "items": [] },
                { "type": "Column", "width": "${rest}", "style": "emphasis", "minHeight": "6px", "spacing": "None", "items": [] }
              ]
            },
            { "type": "TextBlock", "text": "${reset}", "size": "Small", "isSubtle": true, "wrap": true, "spacing": "Small" }
          ]
        },
        {
          "type": "Container",
          "style": "accent",
          "spacing": "Medium",
          "$when": "${hasAdvice}",
          "items": [
            { "type": "TextBlock", "text": "${advice}", "wrap": true, "size": "Small", "weight": "Bolder" }
          ]
        },
        { "type": "TextBlock", "text": "${updated}", "isSubtle": true, "size": "Small", "spacing": "Medium", "horizontalAlignment": "Right" }
      ]
    }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "${openLabel}", "verb": "open" }
  ]
}
