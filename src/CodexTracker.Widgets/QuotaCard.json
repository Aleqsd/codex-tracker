{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "${empty}", "wrap": true, "isSubtle": true, "$when": "${empty != ''}" },

    {
      "type": "ColumnSet",
      "$when": "${$host.widgetSize == 'small' && count(active) > 0}",
      "columns": [
        {
          "type": "Column", "width": "auto", "verticalContentAlignment": "Center",
          "items": [ { "type": "Image", "url": "${first.ring}", "width": "64px", "height": "64px", "altText": "${first.percent}" } ]
        },
        {
          "type": "Column", "width": "stretch", "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "${first.percent}", "size": "ExtraLarge", "weight": "Bolder", "color": "${first.color}" },
            { "type": "TextBlock", "text": "${first.provider}", "size": "Small", "weight": "Bolder", "spacing": "None", "maxLines": 1 },
            { "type": "TextBlock", "text": "${first.reset}", "size": "Small", "isSubtle": true, "spacing": "None", "maxLines": 1 }
          ]
        }
      ]
    },
    { "type": "TextBlock", "text": "${reserves}", "size": "Small", "color": "Accent", "spacing": "Small", "$when": "${$host.widgetSize == 'small' && reserves != ''}" },

    {
      "type": "Container",
      "$when": "${$host.widgetSize != 'small' && next != null}",
      "spacing": "None",
      "items": [
        { "type": "TextBlock", "text": "${next.label}", "size": "Small", "isSubtle": true, "$when": "${$host.widgetSize == 'large'}" },
        { "type": "TextBlock", "text": "${next.countdown}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None", "$when": "${$host.widgetSize == 'large'}" },
        { "type": "TextBlock", "text": "${next.detail}", "size": "Small", "isSubtle": true, "spacing": "None", "wrap": true, "$when": "${$host.widgetSize == 'large'}" }
      ]
    },
    {
      "type": "ColumnSet",
      "$when": "${$host.widgetSize == 'large'}",
      "spacing": "Medium",
      "columns": [
        {
          "type": "Column", "width": "stretch", "$data": "${week}", "spacing": "None",
          "items": [
            { "type": "TextBlock", "text": "${day}", "size": "Small", "horizontalAlignment": "Center", "isSubtle": "${level == 0}", "weight": "${if(level > 0, 'Bolder', 'Default')}" },
            { "type": "Image", "url": "${cell}", "size": "Stretch", "spacing": "Small", "altText": "${day}" }
          ]
        }
      ]
    },

    {
      "type": "Container",
      "$when": "${$host.widgetSize != 'small'}",
      "spacing": "Medium",
      "items": [
        {
          "type": "Container",
          "$data": "${tracked}",
          "spacing": "Small",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${name} · ${provider}", "maxLines": 1, "size": "Small", "weight": "${if(active, 'Bolder', 'Default')}" } ] },
                { "type": "Column", "width": "auto", "items": [ { "type": "TextBlock", "text": "${percent}", "size": "Small", "weight": "Bolder", "color": "${color}" } ] }
              ]
            },
            { "type": "Image", "url": "${gauge}", "size": "Stretch", "spacing": "Small", "altText": "${percent}" }
          ]
        },
        { "type": "TextBlock", "text": "${reserve}", "size": "Small", "color": "Accent", "spacing": "Medium", "wrap": true, "$when": "${$host.widgetSize == 'large' && reserve != ''}" },
        {
          "type": "Container", "style": "emphasis", "spacing": "Medium", "$when": "${hasAdvice}",
          "items": [ { "type": "TextBlock", "text": "${advice}", "wrap": true, "size": "Small", "weight": "Bolder", "color": "Accent" } ]
        },
        { "type": "TextBlock", "text": "${updated}", "isSubtle": true, "size": "Small", "spacing": "Small", "horizontalAlignment": "Right" }
      ]
    }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "${openLabel}", "verb": "open" },
    { "type": "Action.Execute", "title": "${refreshLabel}", "verb": "refresh" }
  ]
}
